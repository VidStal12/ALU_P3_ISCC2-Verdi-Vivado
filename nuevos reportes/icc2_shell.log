    set lyr_name [get_object_name $lyr]
    if {[string match -nocase "*M*" $lyr_name]} {
        catch {set_attribute $lyr routing_direction $dir}
        if {$dir eq "horizontal"} { set dir "vertical" } else { set dir "horizontal" }
    }
}
